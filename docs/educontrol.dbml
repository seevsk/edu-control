CREATE TABLE "usuario" (
  "id_usuario" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "google_id" varchar UNIQUE NOT NULL,
  "correo" varchar UNIQUE NOT NULL,
  "dominio_correo" varchar,
  "nombre" varchar NOT NULL,
  "apellidos" varchar,
  "foto_url" varchar,
  "eliminado_en" timestamp,
  "fecha_registro" timestamp DEFAULT (now())
);

CREATE TABLE "perfil" (
  "id_perfil" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "id_usuario" integer UNIQUE NOT NULL,
  "tipo_cuenta" varchar NOT NULL DEFAULT 'estudiante',
  "institucion" varchar,
  "carrera" varchar,
  "ciclo" integer,
  "biografia" varchar(300),
  "trabaja" boolean DEFAULT false,
  "visible_en_busqueda" boolean DEFAULT true,
  "fecha_actualizacion" timestamp
);

CREATE TABLE "bloque_ocupado" (
  "id_bloque_ocupado" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "id_usuario" integer NOT NULL,
  "tipo" varchar NOT NULL,
  "dia_semana" smallint NOT NULL,
  "hora_inicio" time NOT NULL,
  "hora_fin" time NOT NULL,
  "fecha_creacion" timestamp DEFAULT (now())
);

CREATE TABLE "curso" (
  "id_curso" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "id_usuario" integer NOT NULL,
  "nombre" varchar NOT NULL,
  "modalidad" varchar,
  "codigo" varchar,
  "docente" varchar,
  "activo" boolean DEFAULT true,
  "fecha_creacion" timestamp DEFAULT (now()),
  "importado_de_id_curso" integer
);

CREATE TABLE "horario_curso" (
  "id_horario" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "id_curso" integer NOT NULL,
  "dia_semana" smallint NOT NULL,
  "hora_inicio" time NOT NULL,
  "hora_fin" time NOT NULL,
  "importado_de_id_horario" integer
);

CREATE TABLE "evaluacion" (
  "id_evaluacion" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "id_curso" integer NOT NULL,
  "nombre" varchar NOT NULL,
  "fecha_apertura" timestamp,
  "fecha_cierre" timestamp NOT NULL,
  "requiere_entrega" boolean DEFAULT true,
  "fecha_entrega" timestamp,
  "fecha_creacion" timestamp DEFAULT (now()),
  "importado_de_id_evaluacion" integer
);

CREATE TABLE "grupo" (
  "id_grupo" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "id_creador" integer NOT NULL,
  "nombre" varchar NOT NULL,
  "descripcion" varchar,
  "id_evaluacion" integer,
  "fecha_limite" timestamp,
  "enlace_trabajo" varchar,
  "estado" varchar NOT NULL DEFAULT 'activo',
  "fecha_creacion" timestamp DEFAULT (now())
);

CREATE TABLE "grupo_integrante" (
  "id_integrante" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "id_grupo" integer NOT NULL,
  "id_usuario" integer NOT NULL,
  "rol" varchar NOT NULL DEFAULT 'miembro',
  "estado_invitacion" varchar NOT NULL DEFAULT 'pendiente',
  "correo_actividad" boolean NOT NULL DEFAULT true,
  "fecha_invitacion" timestamp DEFAULT (now()),
  "fecha_respuesta" timestamp
);

CREATE TABLE "tarea" (
  "id_tarea" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "id_grupo" integer NOT NULL,
  "id_creador" integer NOT NULL,
  "id_asignado" integer,
  "titulo" varchar NOT NULL,
  "descripcion" varchar,
  "estado" varchar NOT NULL DEFAULT 'pendiente',
  "peso" smallint NOT NULL DEFAULT 1,
  "fecha_limite" timestamp,
  "fecha_terminada" timestamp,
  "fecha_creacion" timestamp DEFAULT (now())
);

CREATE TABLE "tarea_historial" (
  "id_historial" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "id_tarea" integer NOT NULL,
  "id_usuario" integer NOT NULL,
  "accion" varchar NOT NULL,
  "valor_anterior" varchar,
  "valor_nuevo" varchar,
  "fecha" timestamp NOT NULL DEFAULT (now())
);

CREATE TABLE "notificacion" (
  "id_notificacion" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "id_usuario" integer NOT NULL,
  "tipo" varchar NOT NULL,
  "mensaje" varchar NOT NULL,
  "enlace" varchar,
  "leida" boolean NOT NULL DEFAULT false,
  "estado_correo" varchar NOT NULL DEFAULT 'no_aplica',
  "fecha_creacion" timestamp DEFAULT (now())
);

CREATE UNIQUE INDEX ON "grupo_integrante" ("id_grupo", "id_usuario");

CREATE INDEX ON "tarea" ("id_grupo", "estado");

CREATE INDEX ON "notificacion" ("id_usuario", "leida");

COMMENT ON COLUMN "usuario"."google_id" IS 'Campo sub del token de Google. Ancla de identidad';

COMMENT ON COLUMN "usuario"."correo" IS 'En minúsculas';

COMMENT ON COLUMN "usuario"."dominio_correo" IS 'Lo que sigue al @. Se recalcula en cada login junto con correo';

COMMENT ON COLUMN "usuario"."eliminado_en" IS 'NULL = cuenta activa. Con valor = cuenta anonimizada';

COMMENT ON COLUMN "perfil"."id_usuario" IS '1:1 con usuario';

COMMENT ON COLUMN "perfil"."tipo_cuenta" IS 'estudiante | profesor. Solo una etiqueta autodeclarada: no da permisos ni excluye de métricas';

COMMENT ON COLUMN "perfil"."institucion" IS 'Texto libre, autodeclarado';

COMMENT ON COLUMN "perfil"."trabaja" IS 'Lo declara el usuario, independiente de si registró horarios';

COMMENT ON COLUMN "bloque_ocupado"."tipo" IS 'laboral | familiar | personal';

COMMENT ON COLUMN "bloque_ocupado"."dia_semana" IS '1 = lunes ... 7 = domingo. Es el día en que EMPIEZA el bloque';

COMMENT ON COLUMN "bloque_ocupado"."hora_fin" IS 'Si hora_fin < hora_inicio, el bloque cruza la medianoche';

COMMENT ON COLUMN "curso"."id_usuario" IS 'Cada usuario registra sus propios cursos';

COMMENT ON COLUMN "curso"."modalidad" IS 'presencial | remoto';

COMMENT ON COLUMN "curso"."activo" IS 'false = ciclo terminado; sus horarios ya no cuentan como ocupados';

COMMENT ON COLUMN "curso"."importado_de_id_curso" IS 'NULL = curso propio. Si no, es una copia sincronizada del curso de otro usuario, traida desde un grupo (grupo -> evaluacion -> curso). nombre/docente/modalidad se sincronizan cuando el original cambia';

COMMENT ON COLUMN "horario_curso"."dia_semana" IS '1 = lunes ... 7 = domingo';

COMMENT ON COLUMN "evaluacion"."fecha_apertura" IS 'Opcional. Desde cuándo se puede entregar o rendir';

COMMENT ON COLUMN "evaluacion"."fecha_cierre" IS 'Límite. Lo usan el calendario y los recordatorios';

COMMENT ON COLUMN "evaluacion"."fecha_entrega" IS 'NULL = aún no entrega. Lo marca el usuario';

COMMENT ON COLUMN "grupo"."id_evaluacion" IS 'Opcional. Solo precarga la fecha límite al crear el grupo';

COMMENT ON COLUMN "grupo"."enlace_trabajo" IS 'Opcional. Validar que empiece con https:// antes de guardar';

COMMENT ON COLUMN "grupo"."estado" IS 'activo | finalizado';

COMMENT ON COLUMN "grupo_integrante"."rol" IS 'lider | miembro | observador';

COMMENT ON COLUMN "grupo_integrante"."estado_invitacion" IS 'pendiente | aceptada | rechazada | retirado';

COMMENT ON COLUMN "grupo_integrante"."correo_actividad" IS 'false = no recibir correos de actividad de este grupo. Los importantes siguen llegando';

COMMENT ON COLUMN "tarea"."id_asignado" IS 'Integrante aceptado (no observador). NULL = sin asignar';

COMMENT ON COLUMN "tarea"."estado" IS 'pendiente | en_progreso | en_revision | completada';

COMMENT ON COLUMN "tarea"."peso" IS '1 a 3, lo define el grupo al crear la tarea';

COMMENT ON COLUMN "tarea"."fecha_terminada" IS 'Cuando el asignado la marcó en_revision. Se borra si la devuelven a en_progreso';

COMMENT ON COLUMN "tarea_historial"."id_usuario" IS 'Quién hizo el cambio. Sale de la sesión del servidor, nunca del navegador';

COMMENT ON COLUMN "tarea_historial"."accion" IS 'creada | estado | reasignada';

COMMENT ON COLUMN "tarea_historial"."valor_anterior" IS 'Estado anterior o id del asignado anterior';

COMMENT ON COLUMN "tarea_historial"."valor_nuevo" IS 'Estado nuevo o id del asignado nuevo';

COMMENT ON COLUMN "notificacion"."id_usuario" IS 'Destinatario. Una fila por destinatario, no por evento';

COMMENT ON COLUMN "notificacion"."tipo" IS 'invitacion_grupo | invitacion_respondida | tarea_asignada | tarea_en_revision | tarea_devuelta | tarea_completada';

COMMENT ON COLUMN "notificacion"."enlace" IS 'Ruta relativa, ej: /grupos/12/tareas/45. La genera el servidor';

COMMENT ON COLUMN "notificacion"."estado_correo" IS 'no_aplica | pendiente | enviado | fallido';

ALTER TABLE "perfil" ADD FOREIGN KEY ("id_usuario") REFERENCES "usuario" ("id_usuario") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "bloque_ocupado" ADD FOREIGN KEY ("id_usuario") REFERENCES "usuario" ("id_usuario") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "curso" ADD FOREIGN KEY ("id_usuario") REFERENCES "usuario" ("id_usuario") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "curso" ADD FOREIGN KEY ("importado_de_id_curso") REFERENCES "curso" ("id_curso") ON DELETE SET NULL DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "horario_curso" ADD FOREIGN KEY ("id_curso") REFERENCES "curso" ("id_curso") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "horario_curso" ADD FOREIGN KEY ("importado_de_id_horario") REFERENCES "horario_curso" ("id_horario") ON DELETE SET NULL DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "evaluacion" ADD FOREIGN KEY ("id_curso") REFERENCES "curso" ("id_curso") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "evaluacion" ADD FOREIGN KEY ("importado_de_id_evaluacion") REFERENCES "evaluacion" ("id_evaluacion") ON DELETE SET NULL DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "grupo" ADD FOREIGN KEY ("id_creador") REFERENCES "usuario" ("id_usuario") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "grupo" ADD FOREIGN KEY ("id_evaluacion") REFERENCES "evaluacion" ("id_evaluacion") ON DELETE SET NULL DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "grupo_integrante" ADD FOREIGN KEY ("id_grupo") REFERENCES "grupo" ("id_grupo") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "grupo_integrante" ADD FOREIGN KEY ("id_usuario") REFERENCES "usuario" ("id_usuario") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "tarea" ADD FOREIGN KEY ("id_grupo") REFERENCES "grupo" ("id_grupo") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "tarea" ADD FOREIGN KEY ("id_creador") REFERENCES "usuario" ("id_usuario") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "tarea" ADD FOREIGN KEY ("id_asignado") REFERENCES "usuario" ("id_usuario") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "tarea_historial" ADD FOREIGN KEY ("id_tarea") REFERENCES "tarea" ("id_tarea") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "tarea_historial" ADD FOREIGN KEY ("id_usuario") REFERENCES "usuario" ("id_usuario") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "notificacion" ADD FOREIGN KEY ("id_usuario") REFERENCES "usuario" ("id_usuario") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;
