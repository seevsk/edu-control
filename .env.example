# Cadena de conexion a Postgres. Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<base>?schema=public
# En local corre en Docker (ver docker-compose.yml). Puerto 5433 porque el 5432 del host ya lo usa otro Postgres local.
# Usuario/password/base deben coincidir con POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB de docker-compose.yml.
DATABASE_URL=postgresql://educontrol:educontrol_dev@localhost:5433/educontrol?schema=public

# URL base de la app. La usa el servidor para armar enlaces absolutos (redirect_uri de Google, enlaces en correos).
# En local: http://localhost:3000. En staging/produccion la define cada entorno (Render).
APP_URL=http://localhost:3000

# Secreto para firmar la cookie de sesion propia (HS256, ver src/server/auth/session.ts).
# Genera uno random de al menos 32 caracteres por entorno, nunca reutilices el de otro entorno.
SESSION_SECRET=

# Credenciales OAuth de Google Cloud (pantalla de consentimiento + credencial "Aplicacion web").
# URI de redireccion autorizada: <APP_URL>/api/auth/google/callback
# Scopes pedidos: openid email profile. No se guarda ningun token de Google (ver AGENTS.md 8.1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Correo (Resend). Solo cuando exista un dominio verificado; ver AGENTS.md seccion 8.6 ---
# RESEND_API_KEY=
# EMAIL_FROM=
